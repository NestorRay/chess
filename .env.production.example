# 项目只监听本机回环端口 127.0.0.1:${HTTP_PORT}，由同机外部反代（nginx/Caddy）转发并提供 HTTPS
# 修改 HTTP_PORT 后，外部反代的转发目标端口需同步修改
HTTP_PORT=8080
APP_ORIGIN=https://chess.example.com

POSTGRES_DB=xiangqi
POSTGRES_USER=xiangqi
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# 经外部反代以 HTTPS 对外访问，Cookie 必须带 Secure；纯 HTTP 直连测试时改回 false 并同步调整 APP_ORIGIN
COOKIE_SECURE=true
