# 对外访问端口(非标端口,不走 80/443 与 TLS)
# 修改此值后,APP_ORIGIN 中的端口需同步修改
HTTP_PORT=8080
DOMAIN=chess.example.com
APP_ORIGIN=http://chess.example.com:8080

POSTGRES_DB=xiangqi
POSTGRES_USER=xiangqi
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# 通过 HTTPS 访问时改为 true，会话 Cookie 将强制 Secure；纯 HTTP 下必须保持 false
COOKIE_SECURE=false
